# Cloud SQL (Postgres). Never commit real values.
# DB_PASSWORD lives in Secret Manager:
#   gcloud secrets versions access latest --secret=agenthire-db-password --project=project-96b6d773-106a-457a-a46
# DB_SSL_CA is the instance's server CA, on one line with \n escapes:
#   gcloud sql instances describe agenthire-db --project=project-96b6d773-106a-457a-a46 --format="value(serverCaCert.cert)"
DB_HOST=34.181.228.253
DB_PORT=5432
DB_NAME=agenthire
DB_USER=agenthire_app
DB_PASSWORD=
DB_SSL_CA=

# agent-gateway identity key (EC P-256). It signs this agent's outbound
# envelopes and opens the bodies sealed to it, so the gateway refuses to start
# without one. NEVER commit a value here — .gitignore already refuses
# functions/**/*.key and functions/**/*.pem, and this file is committed.
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# In Cloud Run, prefer the mount: a mounted secret is not in the environment
# block, so it does not show up in `gcloud run services describe`.
AGENT_PRIVATE_KEY_FILE=
AGENT_PRIVATE_KEY_PEM_B64=

# ---------------------------------------------------------------------------
# The WEB TIER's agent identities. Separate variables from the gateway's, and
# separate on purpose: this process signs as BOTH agents and the gateway signs
# as one, so a single AGENT_PRIVATE_KEY_FILE here would be ambiguous about
# which key an envelope was signed with. Same file format, same P-256 rule,
# same loader (functions/agent-gateway/lib/agent-key.mjs).
#
# WHAT EACH ONE IS FOR, AND WHAT IT COSTS:
#   applicant — signs a student's application. The server signs on their
#     behalf; there is no per-student key, so the signature proves the platform
#     sent it and NOT that a particular student authorised it. Said at length
#     in src/lib/a2a-identity.ts and on the apply screen itself.
#   employer  — mints the single-use credential that reads the employer
#     mailbox. Holding it here widens what a compromise of the web tier gets;
#     it buys the mailbox's access rule being enforced for the one caller that
#     actually reads it, rather than only for strangers. src/lib/a2a-mailbox.ts
#     argues both halves of that trade.
#
# Both secrets already exist. In Cloud Run, MOUNT them rather than setting the
# PEM in the environment — a frameworks deploy rewrites plain environment
# variables and preserveExternalChanges has only ever rescued mounted secrets:
#   gcloud run services update ssrproject96b6d773106a4 --region us-east1 \
#     --update-secrets=/etc/a2a/applicant-key.pem=a2a-applicant-agent-key:latest \
#     --update-secrets=/etc/a2a/employer-key.pem=a2a-employer-agent-key:latest
A2A_APPLICANT_KEY_FILE=
A2A_APPLICANT_KEY_PEM_B64=
A2A_EMPLOYER_KEY_FILE=
A2A_EMPLOYER_KEY_PEM_B64=

# Where the employer agent ANSWERS. Not a2a_agents.endpoint, which is the
# address the agent PUBLISHES and whose job is to be checked against the domain
# its name claims — today the two differ, because the service answers on a
# run.app host that is not under agenthire.biz and would fail that very check.
# Conflating them would mean either dialling something unverified or publishing
# something unroutable. Defaults to the Cloud Run URL; set it to a local
# gateway for development.
#
# The service requires IAM invocation. On Cloud Run the token comes from the
# metadata server; on a laptop set A2A_INVOKER_ID_TOKEN from
# `gcloud auth print-identity-token`.
A2A_EMPLOYER_GATEWAY_URL=
A2A_INVOKER_ID_TOKEN=
